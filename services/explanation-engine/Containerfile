# ============================================================
# explanation-engine — Explanation Engine Service
# Base: registry.access.redhat.com/ubi9/python-311
# OpenShift-compatible, rootless (USER 1001)
# ============================================================

FROM registry.access.redhat.com/ubi9/python-311:latest AS builder

WORKDIR /build

RUN pip install --no-cache-dir --upgrade pip==24.3.1 poetry==1.8.5

COPY pyproject.toml ./
COPY shared/ ./shared/

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --without dev \
    && pip install --no-cache-dir -e ./shared

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:latest AS runtime

LABEL org.opencontainers.image.title="ei-ads-explanation-engine" \
      org.opencontainers.image.description="EI-ADS Explanation Engine Service" \
      org.opencontainers.image.vendor="ESDC EI-ADS Team"

WORKDIR /app

COPY --from=builder /usr/lib/python3.11/site-packages /usr/lib/python3.11/site-packages
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --from=builder /build/shared ./shared
COPY services/explanation-engine/ ./

USER 1001

EXPOSE 8015

ENTRYPOINT ["uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "8015", "--workers", "2"]
