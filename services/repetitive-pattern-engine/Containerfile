# ============================================================
# repetitive-pattern-engine — Repetitive Pattern Detection Engine
# Base: registry.access.redhat.com/ubi9/python-311 (pinned tag)
# OpenShift-compatible, rootless (USER 1001)
#
# Build context is the MONOREPO ROOT so the shared/ package and the
# service source are both available (see scripts/build-images.sh, task 35.2):
#   podman build -f services/repetitive-pattern-engine/Containerfile .
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:9.5 AS builder

# Build RUN steps do not activate the image venv; point poetry at it so
# packages install into /opt/app-root (where the base python/pip look).
ENV VIRTUAL_ENV=/opt/app-root

WORKDIR /build

# Build tooling only lives in this stage; it never reaches the runtime image.
RUN pip install --no-cache-dir --upgrade pip==24.3.1 poetry==1.8.5

# Copy dependency manifests first for layer caching, then the shared package.
COPY pyproject.toml ./
COPY shared/ ./shared/

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --without dev

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:9.5 AS runtime

LABEL org.opencontainers.image.title="ei-ads-repetitive-pattern-engine" \
      org.opencontainers.image.description="EI-ADS Repetitive Pattern Detection Engine" \
      org.opencontainers.image.vendor="ESDC EI-ADS Team"

WORKDIR /app

# Copy ONLY the installed packages and console scripts from the builder —
# no compilers, no Poetry, no dev tools.
# The ubi9/python-311 base installs into the /opt/app-root venv; copy the
# whole venv (packages + console scripts) rather than the /usr/* paths.
COPY --from=builder /opt/app-root /opt/app-root

# Application source: the shared package plus this service's code.
COPY --from=builder /build/shared ./shared
COPY services/repetitive-pattern-engine/ ./

# Drop to the non-root OpenShift default UID.
USER 1001

# Service port is taken from config.py (repetitive_pattern_engine_port = 8021).
EXPOSE 8021

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8021/healthz', timeout=2).status==200 else 1)"]

ENTRYPOINT ["uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "8021", "--workers", "2"]
