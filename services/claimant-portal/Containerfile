# ============================================================
# claimant-portal — React + TypeScript Claimant Portal
# Base: registry.access.redhat.com/ubi9/nodejs-20 (pinned tag)
# OpenShift-compatible, rootless (USER 1001)
#
# Build context is the MONOREPO ROOT so the build matches the other services
# (see scripts/build-images.sh, task 35.2):
#   podman build -f services/claimant-portal/Containerfile .
# ============================================================

# ── Stage 1: Builder (Node.js) ───────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-20:9.5 AS builder

WORKDIR /build

# Copy package manifests first for layer caching
COPY services/claimant-portal/package.json services/claimant-portal/package-lock.json* ./

# Install exact pinned dependencies (no lockfile mutation)
RUN npm ci --ignore-scripts

# Copy source and build
COPY services/claimant-portal/ ./
RUN npm run build

# ── Stage 2: Runtime (serve static assets via Node) ─────────
FROM registry.access.redhat.com/ubi9/nodejs-20:9.5 AS runtime

LABEL org.opencontainers.image.title="ei-ads-claimant-portal" \
      org.opencontainers.image.description="EI-ADS Claimant Portal (React + TypeScript)" \
      org.opencontainers.image.vendor="ESDC EI-ADS Team"

WORKDIR /app

# Install a minimal static file server
RUN npm install --global serve@14.2.4

# Copy built assets from builder
COPY --from=builder /build/dist ./dist

USER 1001

EXPOSE 3000

# Static SPA server has no /healthz; probe the served index instead.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["node", "-e", "require('http').get('http://127.0.0.1:3000/',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

ENTRYPOINT ["serve"]
CMD ["-s", "dist", "-l", "3000"]
