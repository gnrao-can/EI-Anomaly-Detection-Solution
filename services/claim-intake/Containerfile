# ============================================================
# claim-intake — Claim Intake Service
# Base: registry.access.redhat.com/ubi9/python-311 (pinned tag)
# OpenShift-compatible, rootless (USER 1001)
#
# Build context is the MONOREPO ROOT so the shared/ package and the
# service source are both available (see scripts/build-images.sh, task 35.2):
#   podman build -f services/claim-intake/Containerfile .
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:9.5 AS builder

WORKDIR /build

# Install build tools
RUN pip install --no-cache-dir --upgrade pip==24.3.1 poetry==1.8.5

# Copy dependency manifests first for layer caching
COPY pyproject.toml ./
COPY shared/ ./shared/

# Export requirements and install into a prefix
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --without dev \
    && pip install --no-cache-dir -e ./shared

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:9.5 AS runtime

LABEL org.opencontainers.image.title="ei-ads-claim-intake" \
      org.opencontainers.image.description="EI-ADS Claim Intake Service" \
      org.opencontainers.image.vendor="ESDC EI-ADS Team"

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/lib/python3.11/site-packages /usr/lib/python3.11/site-packages
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy shared package and service source
COPY --from=builder /build/shared ./shared
COPY services/claim-intake/ ./

# Drop to non-root (OpenShift default UID)
USER 1001

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/healthz', timeout=2).status==200 else 1)"]

ENTRYPOINT ["uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
