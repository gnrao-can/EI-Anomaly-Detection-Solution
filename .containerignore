# ============================================================
# .containerignore — root-level build context exclusions
# Applied when building all service images from the monorepo root.
# ============================================================

# Python artefacts
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
# Node / frontend artefacts — the claimant-portal image runs `npm ci` fresh,
# so the local node_modules (and Vite/build output) must NOT enter the build
# context. Besides bloating it ~112 MB, a partially-materialised Google Drive
# File Stream file (e.g. node_modules/.vite/deps/_metadata.json) triggers an
# "input/output error" mid-COPY and fails the build.
**/node_modules
**/.vite
**/dist
**/*.tsbuildinfo

# Test code — never in production images
tests/
**/test_*.py
**/*_test.py

# Mock / dev data — never in production images
mock-data/

# Secrets and credentials
.env
.env.*
!.env.example
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx

# Dev tooling
.git/
.gitignore
.kiro/
demo/
docs/
sbom/
scripts/
*.md
!services/*/README.md

# OS artefacts
.DS_Store
**/.DS_Store
Thumbs.db

# CI/CD configs (not needed at runtime)
.github/
.tekton/
