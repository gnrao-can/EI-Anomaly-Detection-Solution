# ============================================================
# EI-ADS Local Development Environment Variables
# Copy this file to .env and fill in values for local dev.
# NEVER commit .env to version control.
# ============================================================

# ── Deployment Environment ───────────────────────────────────
# Options: development | test | production
APP_ENV=development

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
# In production these are 3 and 2 respectively (Req 23.4)

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Redis cluster nodes (comma-separated) for production:
# REDIS_CLUSTER_NODES=localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ei_ads
POSTGRES_USER=ei_ads_app
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_SSL_MODE=disable
# In production: POSTGRES_SSL_MODE=require with TLS 1.3 (Req 1.11)

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ei_ads_analytics
CLICKHOUSE_USER=ei_ads_app
CLICKHOUSE_PASSWORD=changeme_local_only

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# ── GCKey OAuth 2.0 ─────────────────────────────────────────
GCKEY_JWKS_URL=https://auth.id.gc.ca/.well-known/jwks.json
GCKEY_CLIENT_ID=ei-ads-local
GCKEY_CLIENT_SECRET=changeme_local_only
GCKEY_REDIRECT_URI=http://localhost:3000/auth/callback
# In production use the GC Identity Provider endpoint

# ── SIN Hashing Salt ─────────────────────────────────────────
# Per-environment salt for SHA-256 SIN hashing (Req 1.11, 19.1)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SIN_HASH_SALT=changeme_generate_a_real_64char_hex_salt_for_local_dev

# ── External Data Adapters ───────────────────────────────────
# Stats Canada — no auth required (public API)
STATSCAN_API_BASE_URL=https://www150.statcan.gc.ca/t1/tbl1/en/dtbl/download
STATSCAN_CONNECT_TIMEOUT=10
STATSCAN_READ_TIMEOUT=30

# CRA — mTLS certificate paths (leave blank for dev; synthetic data used)
CRA_API_BASE_URL=https://secure-exchange.cra-arc.gc.ca/ei-ads
CRA_CLIENT_CERT_PATH=
CRA_CLIENT_KEY_PATH=
CRA_TIMEOUT=5

# CBSA — mTLS over Protected B channel (leave blank for dev; synthetic data used)
CBSA_API_BASE_URL=https://cbsa-asfc.gc.ca/ei-ads/api
CBSA_CLIENT_CERT_PATH=
CBSA_CLIENT_KEY_PATH=
CBSA_TIMEOUT=5

# GeoNames
GEONAMES_USERNAME=changeme_geonames_username
GEONAMES_API_BASE_URL=http://api.geonames.org
GEONAMES_RATE_LIMIT_PER_HOUR=2000

# Business Registry
CORPORATIONS_CANADA_API_KEY=changeme_local
CORPORATIONS_CANADA_API_BASE_URL=https://api.corporationscanada.ic.gc.ca/v1

# Provincial Registry API keys (one per province/territory)
PROV_REG_API_KEY_AB=changeme
PROV_REG_API_KEY_BC=changeme
PROV_REG_API_KEY_MB=changeme
PROV_REG_API_KEY_NB=changeme
PROV_REG_API_KEY_NL=changeme
PROV_REG_API_KEY_NS=changeme
PROV_REG_API_KEY_NT=changeme
PROV_REG_API_KEY_NU=changeme
PROV_REG_API_KEY_ON=changeme
PROV_REG_API_KEY_PE=changeme
PROV_REG_API_KEY_QC=changeme
PROV_REG_API_KEY_SK=changeme
PROV_REG_API_KEY_YT=changeme

# MVR — provincial motor vehicle registry API keys
MVR_API_KEY_AB=changeme
MVR_API_KEY_BC=changeme
MVR_API_KEY_MB=changeme
MVR_API_KEY_NB=changeme
MVR_API_KEY_NL=changeme
MVR_API_KEY_NS=changeme
MVR_API_KEY_ON=changeme
MVR_API_KEY_PE=changeme
MVR_API_KEY_QC=changeme
MVR_API_KEY_SK=changeme

# Job Bank
JOB_BANK_API_KEY=changeme_local
JOB_BANK_API_BASE_URL=https://www.jobbank.gc.ca/api

# ── LLM Service ──────────────────────────────────────────────
LLM_SERVICE_URL=http://localhost:8090
LLAMA_MODEL_PATH=models/llama-3.1-70b.Q4_K_M.gguf
LLAMA_N_CTX=4096
LLAMA_N_GPU_LAYERS=0
# In production on GPU node: LLAMA_N_GPU_LAYERS=80

# ── OpenShift Image Registry (CI/CD only) ────────────────────
OCP_REGISTRY=image-registry.openshift-image-registry.svc:5000
OCP_USER=ci-bot
OCP_TOKEN=changeme

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ei-ads
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# ── Service Ports (local dev) ────────────────────────────────
CLAIM_INTAKE_PORT=8001
ROE_ADAPTER_PORT=8002
PIPELINE_ORCHESTRATOR_PORT=8003
ENSEMBLE_SCORER_PORT=8004
LLM_SERVICE_PORT=8005
GRAPH_SERVICE_PORT=8006
REPETITIVE_PATTERN_ENGINE_PORT=8007
GEOGRAPHIC_ANOMALY_ENGINE_PORT=8008
FRAUD_RING_ENGINE_PORT=8009
HISTORY_INCONSISTENCY_ENGINE_PORT=8010
DOCUMENT_FORGERY_ENGINE_PORT=8011
REGIONAL_ANALYSIS_ENGINE_PORT=8012
CLAIMANT_PORTAL_PORT=3000
